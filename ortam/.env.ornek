# Bu dosyayı lab klasörüne .env adıyla kopyalayın, değerleri kendi hesabınızdan doldurun. .env'i kimseyle paylaşmayın.
# Yol A (en kolay): Google AI Studio anahtarı — aistudio.google.com → Get API key
GOOGLE_API_KEY=
# Yol B: Vertex AI (Google Cloud) — anahtar yerine bu üçü; önce: gcloud auth application-default login
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=proje-kimliginiz
# GOOGLE_CLOUD_LOCATION=us-central1
# Köprü (ders 3.2): ses akışını koruyan gizli yol parçası — uzun, rastgele bir değer
SESLI_ANAHTAR=
# Twilio (ders 3.1–3.2): gelen aramanın gerçekten Twilio'dan geldiğini imzayla doğrulamak için
TWILIO_AUTH_TOKEN=
