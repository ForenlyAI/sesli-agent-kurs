{
  "name": "Sesli Agent 101 — Gemini Live + Twilio köprüsü (Python 3.12)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "forwardPorts": [
    8080
  ],
  "portsAttributes": {
    "8080": {
      "label": "Köprü (kopru.py)",
      "onAutoForward": "notify"
    }
  },
  "secrets": {
    "GOOGLE_API_KEY": {
      "description": "Google AI Studio anahtarı (aistudio.google.com → Get API key). Gemini Live modeline bağlanmak için.",
      "documentationUrl": "https://ai.google.dev/gemini-api/docs/api-key"
    }
  },
  "postCreateCommand": "pip install --user uv && uv sync && cp -n ortam/.env.ornek .env",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ],
      "settings": {
        "workbench.startupEditor": "readme"
      }
    },
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  }
}
